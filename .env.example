# =============================================================================
# ticket-booking-api - environment variables (validated at boot by src/core/config/env.schema.ts)
# Copy to .env (local) or map into Kubernetes ConfigMap / Secret.
# Variables marked [SECRET] must come from a Secret store, never a ConfigMap.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development                # development | production | test
PORT=3000
API_PREFIX=api/v1
# Comma-separated. Supports exact origins, "*.domain.com" (https subdomains) and /regex/.
# "*" is rejected when NODE_ENV=production.
ALLOWED_ORIGINS=*
# Express "trust proxy": false | true | <hop count> | subnet list. Behind one K8s ingress: 1
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace (default: info in production, debug otherwise)
# LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=5432
DB_MASTER_USER=postgres
DB_MASTER_PASSWORD=change-me        # [SECRET]
DB_NAME=ticket_booking
# Optional read replica; leave empty to read from master
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=                # [SECRET]
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Redis (mandatory in production) -------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=                     # [SECRET]
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=tba:

# --- Encryption & JWT --------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=                     # [SECRET] 64 hex chars
ENCRYPTION_KEY_VERSION=v1
# Previous keys kept for decrypting old rows after rotation: "v0:<64hex>,v-1:<64hex>"
ENCRYPTION_LEGACY_KEYS=             # [SECRET]
JWT_SECRET=                         # [SECRET] >= 32 chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=                 # [SECRET] >= 32 chars, must differ from JWT_SECRET in production
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate limiting (window shared by all tiers) --------------------------------
THROTTLE_TTL=60000                  # ms
THROTTLE_LIMIT=60                   # public tier (default for every route)
THROTTLE_SEARCH_LIMIT=100           # @ThrottleSearch()
THROTTLE_SENSITIVE_LIMIT=5          # @ThrottleSensitive()

# --- Resilience --------------------------------------------------------------
CIRCUIT_BREAKER_TIMEOUT_MS=8000
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# --- Graceful shutdown (SHUTDOWN_TIMEOUT_MS < terminationGracePeriodSeconds) ----
SHUTDOWN_DRAIN_DELAY_MS=5000        # set 0 for local development
SHUTDOWN_HOOK_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=25000
